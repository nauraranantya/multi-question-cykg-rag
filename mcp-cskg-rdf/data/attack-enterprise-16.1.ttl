<http://w3id.org/sepses/resource/attack/group/G0093> a attack:AdversaryGroup ;
    dcterm:created "2019-07-18T20:47:50.050000+00:00"^^xsd:dateTime ;
    dcterm:description "[GALLIUM](https://attack.mitre.org/groups/G0093) is a cyberespionage group that has been active since at least 2012, primarily targeting telecommunications companies, financial institutions, and government entities in Afghanistan, Australia, Belgium, Cambodia, Malaysia, Mozambique, the Philippines, Russia, and Vietnam. This group is particularly known for launching Operation Soft Cell, a long-term campaign targeting telecommunications providers. Security researchers have identified [GALLIUM](https://attack.mitre.org/groups/G0093) as a likely Chinese state-sponsored group, based in part on tools used and TTPs commonly associated with Chinese threat actors." ;
    dcterm:identifier "G0093" ;
    dcterm:modified "2024-04-17T22:10:27.139000+00:00"^^xsd:dateTime ;
    dcterm:title "GALLIUM" ;

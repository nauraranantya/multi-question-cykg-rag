<http://w3id.org/sepses/resource/attack/group/G0035> a attack:AdversaryGroup ;
    dcterm:created "2017-05-31T21:32:05.217000+00:00"^^xsd:dateTime ;
    dcterm:description "[Dragonfly](https://attack.mitre.org/groups/G0035) is a cyber espionage group that has been attributed to Russia's Federal Security Service (FSB) Center 16. Active since at least 2010, [Dragonfly](https://attack.mitre.org/groups/G0035) has targeted defense and aviation companies, government entities, companies related to industrial control systems, and critical infrastructure sectors worldwide through supply chain, spearphishing, and drive-by compromise attacks." ;
    dcterm:identifier "G0035" ;

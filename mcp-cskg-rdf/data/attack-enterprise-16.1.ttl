    dcterm:created "2022-10-04T21:48:00.086000+00:00"^^xsd:dateTime ;
    dcterm:description "[SUGARUSH](https://attack.mitre.org/software/S1049) is a small custom backdoor that can establish a reverse shell over TCP to a hard coded C2 address. [SUGARUSH](https://attack.mitre.org/software/S1049) was first identified during analysis of UNC3890's [C0010](https://attack.mitre.org/campaigns/C0010) campaign targeting Israeli companies, which began in late 2020." ;
    dcterm:identifier "S1049" ;
    dcterm:modified "2022-10-04T21:50:36.241000+00:00"^^xsd:dateTime ;

        <http://w3id.org/sepses/resource/attack/technique/T1053.005>,
        <http://w3id.org/sepses/resource/attack/technique/T1055>,
        <http://w3id.org/sepses/resource/attack/technique/T1055.003>,
        <http://w3id.org/sepses/resource/attack/technique/T1070.004>,
        <http://w3id.org/sepses/resource/attack/technique/T1070.006>,
        <http://w3id.org/sepses/resource/attack/technique/T1071.001>,
        <http://w3id.org/sepses/resource/attack/technique/T1105>,
        <http://w3id.org/sepses/resource/attack/technique/T1480.002>,

    dcterm:created "2024-03-06T19:14:43.437000+00:00"^^xsd:dateTime ;
    dcterm:description "[GLASSTOKEN](https://attack.mitre.org/software/S1117) is a custom web shell used by threat actors during [Cutting Edge](https://attack.mitre.org/campaigns/C0029) to execute commands on compromised Ivanti Secure Connect VPNs." ;
    dcterm:identifier "S1117" ;

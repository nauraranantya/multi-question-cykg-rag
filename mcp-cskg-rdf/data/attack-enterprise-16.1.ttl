<http://w3id.org/sepses/resource/attack/software/S0458> a attack:Malware ;
    dcterm:created "2020-05-27T16:58:08.242000+00:00"^^xsd:dateTime ;
    dcterm:description "[Ramsay](https://attack.mitre.org/software/S0458) is an information stealing malware framework designed to collect and exfiltrate sensitive documents, including from air-gapped systems. Researchers have identified overlaps between [Ramsay](https://attack.mitre.org/software/S0458) and the [Darkhotel](https://attack.mitre.org/groups/G0012)-associated Retro malware." ;
    dcterm:identifier "S0458" ;
    dcterm:modified "2021-04-14T22:10:12.150000+00:00"^^xsd:dateTime ;
    dcterm:title "Ramsay" ;
    attack:implementsTechnique <http://w3id.org/sepses/resource/attack/technique/T1005>,

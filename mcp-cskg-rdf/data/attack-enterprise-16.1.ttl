<http://w3id.org/sepses/resource/attack/group/G0020> a attack:AdversaryGroup ;
    dcterm:created "2017-05-31T21:31:54.697000+00:00"^^xsd:dateTime ;
    dcterm:description "[Equation](https://attack.mitre.org/groups/G0020) is a sophisticated threat group that employs multiple remote access tools. The group is known to use zero-day exploits and has developed the capability to overwrite the firmware of hard disk drives." ;

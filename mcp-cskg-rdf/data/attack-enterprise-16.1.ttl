<http://w3id.org/sepses/resource/attack/group/G0065> a attack:AdversaryGroup ;
    dcterm:created "2018-04-18T17:59:24.739000+00:00"^^xsd:dateTime ;
    dcterm:description "[Leviathan](https://attack.mitre.org/groups/G0065) is a Chinese state-sponsored cyber espionage group that has been attributed to the Ministry of State Security's (MSS) Hainan State Security Department and an affiliated front company. Active since at least 2009, [Leviathan](https://attack.mitre.org/groups/G0065) has targeted the following sectors: academia, aerospace/aviation, biomedical, defense industrial base, government, healthcare, manufacturing, maritime, and transportation across the US, Canada, Europe, the Middle East, and Southeast Asia." ;
    dcterm:identifier "G0065" ;
    dcterm:modified "2024-01-08T20:33:16.460000+00:00"^^xsd:dateTime ;

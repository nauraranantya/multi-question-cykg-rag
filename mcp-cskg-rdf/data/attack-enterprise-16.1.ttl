<http://w3id.org/sepses/resource/attack/group/G1036> a attack:AdversaryGroup ;
    dcterm:created "2024-08-26T17:39:06.020000+00:00"^^xsd:dateTime ;
    dcterm:description "[Moonstone Sleet](https://attack.mitre.org/groups/G1036) is a North Korean-linked threat actor executing both financially motivated attacks and espionage operations. The group previously overlapped significantly with another North Korean-linked entity, [Lazarus Group](https://attack.mitre.org/groups/G0032), but has differentiated its tradecraft since 2023. [Moonstone Sleet](https://attack.mitre.org/groups/G1036) is notable for creating fake companies and personas to interact with victim entities, as well as developing unique malware such as a variant delivered via a fully functioning game." ;
    dcterm:identifier "G1036" ;
    dcterm:modified "2024-10-01T11:51:31.065000+00:00"^^xsd:dateTime ;
    dcterm:title "Moonstone Sleet" ;
    attack:aliases "Storm-1789" ;

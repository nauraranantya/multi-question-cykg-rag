<http://w3id.org/sepses/resource/attack/group/G0115> a attack:AdversaryGroup ;
    dcterm:created "2020-09-22T19:41:27.845000+00:00"^^xsd:dateTime ;
    dcterm:description "[GOLD SOUTHFIELD](https://attack.mitre.org/groups/G0115) is a financially motivated threat group active since at least 2018 that operates the [REvil](https://attack.mitre.org/software/S0496) Ransomware-as-a Service (RaaS). [GOLD SOUTHFIELD](https://attack.mitre.org/groups/G0115) provides backend infrastructure for affiliates recruited on underground forums to perpetrate high value deployments. By early 2020, [GOLD SOUTHFIELD](https://attack.mitre.org/groups/G0115) started capitalizing on the new trend of stealing data and further extorting the victim to pay for their data to not get publicly leaked." ;
    dcterm:identifier "G0115" ;
    dcterm:modified "2023-03-28T20:49:53.223000+00:00"^^xsd:dateTime ;
    dcterm:title "GOLD SOUTHFIELD" ;
    attack:aliases "Pinchy Spider" ;
    attack:usesMalware <http://w3id.org/sepses/resource/attack/software/S0496> ;
    attack:usesSoftware <http://w3id.org/sepses/resource/attack/software/S0591> ;
    attack:usesTechnique <http://w3id.org/sepses/resource/attack/technique/T1027.010>,
        <http://w3id.org/sepses/resource/attack/technique/T1059.001>,

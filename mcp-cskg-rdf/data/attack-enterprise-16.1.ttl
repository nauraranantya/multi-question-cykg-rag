<http://w3id.org/sepses/resource/attack/group/G1028> a attack:AdversaryGroup ;
    dcterm:created "2024-03-26T18:38:00.759000+00:00"^^xsd:dateTime ;
    dcterm:description "[APT-C-23](https://attack.mitre.org/groups/G1028) is a threat group that has been active since at least 2014. [APT-C-23](https://attack.mitre.org/groups/G1028) has primarily focused its operations on the Middle East, including Israeli military assets. [APT-C-23](https://attack.mitre.org/groups/G1028) has developed mobile spyware targeting Android and iOS devices since 2017." ;
    dcterm:identifier "G1028" ;
    dcterm:modified "2024-04-16T15:31:48.747000+00:00"^^xsd:dateTime ;

<http://w3id.org/sepses/resource/attack/group/G1004> a attack:AdversaryGroup ;
    dcterm:created "2022-06-09T19:14:31.327000+00:00"^^xsd:dateTime ;
    dcterm:description "[LAPSUS$](https://attack.mitre.org/groups/G1004) is cyber criminal threat group that has been active since at least mid-2021. [LAPSUS$](https://attack.mitre.org/groups/G1004) specializes in large-scale social engineering and extortion operations, including destructive attacks without the use of ransomware. The group has targeted organizations globally, including in the government, manufacturing, higher education, energy, healthcare, technology, telecommunications, and media sectors." ;
    dcterm:identifier "G1004" ;
    dcterm:modified "2024-01-11T21:51:11.405000+00:00"^^xsd:dateTime ;

<http://w3id.org/sepses/resource/attack/software/S1147> a attack:Malware ;
    dcterm:created "2024-07-25T22:12:08.779000+00:00"^^xsd:dateTime ;
    dcterm:description "[Nightdoor](https://attack.mitre.org/software/S1147) is a backdoor exclusively associated with [Daggerfly](https://attack.mitre.org/groups/G1034) operations. [Nightdoor](https://attack.mitre.org/software/S1147) uses common libraries with [MgBot](https://attack.mitre.org/software/S1146) and [MacMa](https://attack.mitre.org/software/S1016), linking these malware families together." ;
    dcterm:identifier "S1147" ;
    dcterm:modified "2024-10-10T14:35:13.781000+00:00"^^xsd:dateTime ;
    dcterm:title "Nightdoor" ;
    attack:implementsTechnique <http://w3id.org/sepses/resource/attack/technique/T1016>,

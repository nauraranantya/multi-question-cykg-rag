<http://w3id.org/sepses/resource/attack/technique/T1030> a attack:Technique ;
    dcterm:created "2017-05-31T21:30:34.523000+00:00"^^xsd:dateTime ;
    dcterm:description "An adversary may exfiltrate data in fixed size chunks instead of whole files or limit packet sizes below certain thresholds. This approach may be used to avoid triggering network data transfer threshold alerts." ;

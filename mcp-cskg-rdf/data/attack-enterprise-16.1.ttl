<http://w3id.org/sepses/resource/attack/group/G1005> a attack:AdversaryGroup ;
    dcterm:created "2022-07-01T19:07:04.253000+00:00"^^xsd:dateTime ;
    dcterm:description "[POLONIUM](https://attack.mitre.org/groups/G1005) is a Lebanon-based group that has primarily targeted Israeli organizations, including critical manufacturing, information technology, and defense industry companies, since at least February 2022. Security researchers assess [POLONIUM](https://attack.mitre.org/groups/G1005) has coordinated their operations with multiple actors affiliated with Iran’s Ministry of Intelligence and Security (MOIS), based on victim overlap as well as common techniques and tooling." ;
    dcterm:identifier "G1005" ;
    dcterm:modified "2024-01-08T21:56:22.594000+00:00"^^xsd:dateTime ;
    dcterm:title "POLONIUM" ;
    attack:aliases "Plaid Rain" ;
    attack:usesMalware <http://w3id.org/sepses/resource/attack/software/S1023>,
        <http://w3id.org/sepses/resource/attack/software/S1024> ;
    attack:usesTechnique <http://w3id.org/sepses/resource/attack/technique/T1078>,

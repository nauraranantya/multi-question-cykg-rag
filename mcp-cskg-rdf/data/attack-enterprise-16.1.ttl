<http://w3id.org/sepses/resource/attack/technique/T1014> a attack:Technique ;
    dcterm:created "2017-05-31T21:30:26.496000+00:00"^^xsd:dateTime ;
    dcterm:description """Adversaries may use rootkits to hide the presence of programs, files, network connections, services, drivers, and other system components. Rootkits are programs that hide the existence of malware by intercepting/hooking and modifying operating system API calls that supply system information. 

Rootkits or rootkit enabling functionality may reside at the user or kernel level in the operating system or lower, to include a hypervisor, Master Boot Record, or [System Firmware](https://attack.mitre.org/techniques/T1542/001). Rootkits have been seen for Windows, Linux, and Mac OS X systems.""" ;
    dcterm:identifier "T1014" ;
    dcterm:modified "2023-05-09T14:00:00.188000+00:00"^^xsd:dateTime ;
    dcterm:title "Rootkit" ;
    attack:accomplishesTactic <http://w3id.org/sepses/resource/attack/tactic/TA0005> ;

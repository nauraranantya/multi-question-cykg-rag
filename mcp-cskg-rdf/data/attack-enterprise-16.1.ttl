<http://w3id.org/sepses/resource/attack/group/G0133> a attack:AdversaryGroup ;
    dcterm:created "2021-08-24T17:04:27.002000+00:00"^^xsd:dateTime ;
    dcterm:description "[Nomadic Octopus](https://attack.mitre.org/groups/G0133) is a Russian-speaking cyber espionage threat group that has primarily targeted Central Asia, including local governments, diplomatic missions, and individuals, since at least 2014. [Nomadic Octopus](https://attack.mitre.org/groups/G0133) has been observed conducting campaigns involving Android and Windows malware, mainly using the Delphi programming language, and building custom variants." ;
    dcterm:identifier "G0133" ;
    dcterm:modified "2022-09-02T18:03:55.294000+00:00"^^xsd:dateTime ;

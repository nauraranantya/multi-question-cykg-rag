<http://w3id.org/sepses/resource/attack/technique/T1573.001> a attack:SubTechnique,
        attack:Technique ;
    dcterm:created "2020-03-16T15:45:17.032000+00:00"^^xsd:dateTime ;
    dcterm:description "Adversaries may employ a known symmetric encryption algorithm to conceal command and control traffic rather than relying on any inherent protections provided by a communication protocol. Symmetric encryption algorithms use the same key for plaintext encryption and ciphertext decryption. Common symmetric encryption algorithms include AES, DES, 3DES, Blowfish, and RC4." ;
    dcterm:identifier "T1573.001" ;
    dcterm:modified "2023-12-26T20:58:19.356000+00:00"^^xsd:dateTime ;
    dcterm:title "Symmetric Cryptography" ;
    attack:accomplishesTactic <http://w3id.org/sepses/resource/attack/tactic/TA0011> ;

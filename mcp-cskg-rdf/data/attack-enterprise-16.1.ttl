<http://w3id.org/sepses/resource/attack/group/G0103> a attack:AdversaryGroup ;
    dcterm:created "2020-05-12T21:23:59.021000+00:00"^^xsd:dateTime ;
    dcterm:description "[Mofang](https://attack.mitre.org/groups/G0103) is a likely China-based cyber espionage group, named for its frequent practice of imitating a victim's infrastructure. This adversary has been observed since at least May 2012 conducting focused attacks against government and critical infrastructure in Myanmar, as well as several other countries and sectors including military, automobile, and weapons industries." ;
    dcterm:identifier "G0103" ;
    dcterm:modified "2024-04-11T00:41:37.453000+00:00"^^xsd:dateTime ;
    dcterm:title "Mofang" ;
    attack:usesMalware <http://w3id.org/sepses/resource/attack/software/S0444> ;
    attack:usesSoftware <http://w3id.org/sepses/resource/attack/software/S0445> ;
    attack:usesTechnique <http://w3id.org/sepses/resource/attack/technique/T1027.013>,

<http://w3id.org/sepses/resource/attack/group/G0002> a attack:AdversaryGroup ;
    dcterm:created "2017-05-31T21:31:46.025000+00:00"^^xsd:dateTime ;
    dcterm:description "[Moafee](https://attack.mitre.org/groups/G0002) is a threat group that appears to operate from the Guandong Province of China. Due to overlapping TTPs, including similar custom tools, Moafee is thought to have a direct or indirect relationship with the threat group [DragonOK](https://attack.mitre.org/groups/G0017)." ;
    dcterm:identifier "G0002" ;
    dcterm:modified "2022-04-25T14:00:00.188000+00:00"^^xsd:dateTime ;
    dcterm:title "Moafee" ;
    attack:usesMalware <http://w3id.org/sepses/resource/attack/software/S0012> ;
    attack:usesTechnique <http://w3id.org/sepses/resource/attack/technique/T1027.001> .


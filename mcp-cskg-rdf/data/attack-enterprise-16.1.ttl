<http://w3id.org/sepses/resource/attack/software/S0364> a attack:Software ;
    dcterm:created "2019-03-25T12:30:40.919000+00:00"^^xsd:dateTime ;
    dcterm:description "[RawDisk](https://attack.mitre.org/software/S0364) is a legitimate commercial driver from the EldoS Corporation that is used for interacting with files, disks, and partitions. The driver allows for direct modification of data on a local computer's hard drive. In some cases, the tool can enact these raw disk modifications from user-mode processes, circumventing Windows operating system security features." ;
    dcterm:identifier "S0364" ;
    dcterm:modified "2024-08-14T15:22:38.134000+00:00"^^xsd:dateTime ;
    dcterm:title "RawDisk" ;
    attack:implementsTechnique <http://w3id.org/sepses/resource/attack/technique/T1485>,
        <http://w3id.org/sepses/resource/attack/technique/T1561.001>,
        <http://w3id.org/sepses/resource/attack/technique/T1561.002> .

<http://w3id.org/sepses/resource/attack/software/S0413> a attack:Software ;
    dcterm:created "2019-10-05T02:34:01.189000+00:00"^^xsd:dateTime ;
    dcterm:description "MailSniper is a penetration testing tool for searching through email in a Microsoft Exchange environment for specific terms (passwords, insider intel, network architecture information, etc.). It can be used by a non-administrative user to search their own email, or by an Exchange administrator to search the mailboxes of every user in a domain." ;
    dcterm:identifier "S0413" ;
    dcterm:modified "2024-10-14T22:11:30.271000+00:00"^^xsd:dateTime ;
    dcterm:title "MailSniper" ;
    attack:implementsTechnique <http://w3id.org/sepses/resource/attack/technique/T1087.003>,
        <http://w3id.org/sepses/resource/attack/technique/T1110.003>,
        <http://w3id.org/sepses/resource/attack/technique/T1114.002> .

<http://w3id.org/sepses/resource/attack/software/S0416> a attack:Malware ;
    dcterm:created "2019-10-11T16:13:19.588000+00:00"^^xsd:dateTime ;
    dcterm:description "[RDFSNIFFER](https://attack.mitre.org/software/S0416) is a module loaded by [BOOSTWRITE](https://attack.mitre.org/software/S0415) which allows an attacker to monitor and tamper with legitimate connections made via an application designed to provide visibility and system management capabilities to remote IT techs." ;
    dcterm:identifier "S0416" ;
    dcterm:modified "2022-04-25T14:00:00.188000+00:00"^^xsd:dateTime ;

<http://w3id.org/sepses/resource/attack/group/G0087> a attack:AdversaryGroup ;
    dcterm:created "2019-02-19T16:01:38.585000+00:00"^^xsd:dateTime ;
    dcterm:description "[APT39](https://attack.mitre.org/groups/G0087) is one of several names for cyber espionage activity conducted by the Iranian Ministry of Intelligence and Security (MOIS) through the front company Rana Intelligence Computing since at least 2014. [APT39](https://attack.mitre.org/groups/G0087) has primarily targeted the travel, hospitality, academic, and telecommunications industries in Iran and across Asia, Africa, Europe, and North America to track individuals and entities considered to be a threat by the MOIS." ;
    dcterm:identifier "G0087" ;
    dcterm:modified "2024-04-11T02:59:52.392000+00:00"^^xsd:dateTime ;
    dcterm:title "APT39" ;

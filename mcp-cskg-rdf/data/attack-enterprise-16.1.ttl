<http://w3id.org/sepses/resource/attack/software/S1161> a attack:Malware ;
    dcterm:created "2024-09-20T23:08:38.199000+00:00"^^xsd:dateTime ;
    dcterm:description "[BPFDoor](https://attack.mitre.org/software/S1161) is a Linux based passive long-term backdoor used by China-based threat actors. First seen in 2021, [BPFDoor](https://attack.mitre.org/software/S1161) is named after its usage of Berkley Packet Filter (BPF) to execute single task instructions. [BPFDoor](https://attack.mitre.org/software/S1161) supports multiple protocols for communicating with a C2 including TCP, UDP, and ICMP and can start local or reverse shells that bypass firewalls using iptables." ;
    dcterm:identifier "S1161" ;
    dcterm:modified "2024-09-23T21:26:40.646000+00:00"^^xsd:dateTime ;
    dcterm:title "BPFDoor" ;
    attack:aliases "Backdoor.Linux.BPFDOOR",
